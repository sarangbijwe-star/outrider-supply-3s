# ─────────────────────────────────────────────────────────────────────────────
# OUTRIDER SUPPLY — environment variables
#
# Local development: copy this file to `.env.local` and fill in the values.
#   (.env.local is git-ignored — it is never uploaded to GitHub.)
# Production: add the same variables in Vercel → Project → Settings →
#   Environment Variables. Never paste real tokens into code or chat.
#
# If SHOPIFY_STORE_DOMAIN or SHOPIFY_STOREFRONT_PRIVATE_TOKEN is empty, the site
# runs in DEMO MODE with sample products and checkout disabled.
# ─────────────────────────────────────────────────────────────────────────────

# Your store's permanent Shopify address (NOT your custom domain).
# Shopify Admin → Settings → Domains → the one ending in .myshopify.com
SHOPIFY_STORE_DOMAIN=your-store-name.myshopify.com

# Shopify Admin → Sales channels → Headless → your storefront →
#   Storefront API → "Private access token". Server-only — keep it secret.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Storefront API version. Shopify releases a new one every quarter and supports
# each for 12 months. Update this roughly once a year.
SHOPIFY_API_VERSION=2026-07

# Shopify Admin → Settings → Notifications → Webhooks → the signing key shown
# at the bottom of that page ("Your webhooks will be signed with ...").
SHOPIFY_WEBHOOK_SECRET=

# The public address of the site (used for SEO links and the sitemap).
NEXT_PUBLIC_SITE_URL=https://www.shopoutridersupply.com
